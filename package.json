{
  "name": "apsr-connected-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node tests/api.test.mjs && node tests/chat.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "reset": "node server/reset.mjs",
    "preview:harness": "node tests/create-preview.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "22.20.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@playwright/test": "^1.51.0"
  },
  "overrides": {
    "postcss": "8.5.29"
  }
}
